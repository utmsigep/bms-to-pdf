<!DOCTYPE html>
<html>
  <head>
    <title>BMS to PDF</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/3.10.2/mdb.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/3.10.2/mdb.min.js" integrity="sha384-uhiFrMWT42HYzPPRKpjV4R3CuEANqoDxYZNkFYkFuLVbBx18C09moWDB/WTVtAGk" crossorigin="anonymous"></script>

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />

    <meta property="og:title" content="BMS to PDF Converter" />
    <meta property="og:description" content="Take the CSV file exported from mySigEp's Balanced Man Scholarship tool to create a PDF of the applications, one per page." />
    <meta property="og:image" content="/opengraph.png" />

    <% unless ENV['MATOMO_ANALYTICS_URL'].to_s.empty? || ENV['MATOMO_ANALYTICS_SITE_ID'].to_s.empty? %>
    <script>
      var _paq = window._paq = window._paq || [];
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u="<%= ENV['MATOMO_ANALYTICS_URL'] %>";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '<%= ENV['MATOMO_ANALYTICS_SITE_ID'] %>']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
      })();
    </script>
    <% end %>

    <link rel="stylesheet" href="/application.css" />
  </head>

  <body>
    <div class="container" role="main">
      <%= yield %>
    </div>
  </body>
</html>
